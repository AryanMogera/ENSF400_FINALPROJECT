pipeline {
  agent any
  
  environment {
    DOCKER_HUB_CREDS = credentials('docker-hub-credentials')
    DOCKER_IMAGE_NAME = "aryanmogera/ensf_finalproject"
  }

  stages {
    stage('Build') { 
      steps { 
        dir('demo-master') {
          sh 'chmod +x ./gradlew'
          sh './gradlew clean assemble'
        }
      } 
    }
    
    stage('Unit Tests') { 
      steps {
        dir('demo-master') { 
          sh './gradlew test'
        } 
      } 
      post { 
        always { 
          junit 'demo-master/build/test-results/test/*.xml' 
        } 
      } 
    }
    
    stage('SonarQube Analysis') { 
      steps {
        dir('demo-master') { 
          sh './gradlew sonarqube -Dsonar.host.url=https://didactic-garbanzo-76jj64566gvfww76-9000.app.github.dev/ -Dsonar.login=admin -Dsonar.password=qwerty123'
        }
      } 
    }
    
    // Continue with the same pattern for all other stages
    stage('Security Analysis') { 
      steps {
        dir('demo-master') { 
          sh './gradlew dependencyCheckAnalyze'
        }
      } 
    }

    stage('Setup JMeter') {
        steps {
            sh '''
            # Download JMeter using curl
            curl -L https://dlcdn.apache.org//jmeter/binaries/apache-jmeter-5.6.3.tgz -o apache-jmeter-5.6.3.tgz
            # Extract it
            tar -xzf apache-jmeter-5.6.3.tgz
            # Make the JMeter scripts executable
            chmod +x apache-jmeter-5.6.3/bin/jmeter
            chmod +x apache-jmeter-5.6.3/bin/jmeter.sh
            '''
        }
    }
    
    stage('Performance Tests') {
        steps {
            dir('demo-master') {
            sh '''
                # Check where the JMX files are located
                echo "Searching for JMX files:"
                find . -name "*.jmx" | sort
                
                # Create a temporary modified version of the runPerfTests task
                cat > temp_performance_task.gradle << 'EOL'
        task runPerfTests(type:Exec) {
            workingDir '.'
            
            // Linux command for Jenkins with path to our downloaded JMeter
            commandLine '../apache-jmeter-5.6.3/bin/jmeter', '-f', '-n', '-t', 'docs/performance_testing/50_users_at_once.jmx', '-l', 'build/jmeter_perf_test.csv', '-e', '-o', 'build/reports/perf_report'
            
            // Store the output instead of printing to the console
            standardOutput = new ByteArrayOutputStream()
            
            // Extension method to get the output
            ext.output = {
                return standardOutput.toString()
            }
        }
        EOL
                # Run the performance tests with the temporary task
                ./gradlew -I temp_performance_task.gradle runPerfTests
            '''
            }
        }
    }
    
    stage('Build Documentation') {
      steps {
        dir('demo-master') {
          sh './gradlew javadoc'
        }
      }
    }

    stage('Setup Docker Permissions') {
        steps {
            sh '''
       
            if getent group docker > /dev/null; then
                usermod -aG docker jenkins 
            fi
            

            chmod 666 /var/run/docker.sock 
        }
    }
    
    stage('Build Docker Image') {
      steps {
        dir('demo-master') {
          script {
            sh "docker build -t ${DOCKER_IMAGE_NAME}:${env.GIT_COMMIT.take(7)} ."
          }
        }
      }
    }
    
    stage('Push Docker Image') {
      steps {
        script {
          withCredentials([string(credentialsId: 'docker-hub-credentials', variable: 'DOCKER_PASSWORD')]) {
            sh 'echo $DOCKER_PASSWORD | docker login -u aryanmogera --password-stdin'
            sh "docker push ${DOCKER_IMAGE_NAME}:${env.GIT_COMMIT.take(7)}"
          }
        }
      }
    }
    
    stage('Deploy to Test') {
      when {
        branch 'main'
      }
      steps {
        script {
          sh "docker pull ${DOCKER_IMAGE_NAME}:${env.GIT_COMMIT.take(7)}"
          sh "docker stop demo-app || true"
          sh "docker rm demo-app || true"
          sh "docker run -d -p 8081:8080 --name demo-app ${DOCKER_IMAGE_NAME}:${env.GIT_COMMIT.take(7)}"
        }
      }
    }
  }
  
  post {
    always {
      archiveArtifacts artifacts: 'demo-master/build-artifact/**/*', allowEmptyArchive: true
    }
  }
}